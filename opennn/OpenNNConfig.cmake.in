@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Resolve bundled paths before find_dependency(), which can change
# PACKAGE_PREFIX_DIR in consumers using older CMake versions.
if(NOT TARGET OpenNN::jpeg)
    set_and_check(_opennn_jpeg_library "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@_opennn_jpeg_filename@")
    set_and_check(_opennn_jpeg_include "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
    add_library(OpenNN::jpeg STATIC IMPORTED)
    set_target_properties(OpenNN::jpeg PROPERTIES
        IMPORTED_LOCATION "${_opennn_jpeg_library}"
        INTERFACE_INCLUDE_DIRECTORIES "${_opennn_jpeg_include}")
    unset(_opennn_jpeg_library)
    unset(_opennn_jpeg_include)
endif()

if("@_opennn_onednn_bundled@" AND NOT TARGET OpenNN::dnnl)
    set_and_check(_opennn_dnnl_library "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@_opennn_dnnl_filename@")
    add_library(OpenNN::dnnl STATIC IMPORTED)
    set_target_properties(OpenNN::dnnl PROPERTIES
        IMPORTED_LOCATION "${_opennn_dnnl_library}"
        INTERFACE_LINK_LIBRARIES "Threads::Threads;${CMAKE_DL_LIBS}")
    unset(_opennn_dnnl_library)
    find_dependency(Threads)
endif()

if("@_opennn_mkl_bundled@" AND NOT TARGET OpenNN::mkl)
    set_and_check(_opennn_mkl_dir "@PACKAGE_CMAKE_INSTALL_LIBDIR@/opennn-mkl")
    set_and_check(_opennn_mkl_include "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/opennn-mkl")
    set(_opennn_mkl_group "")
    foreach(_opennn_mkl_part intel_lp64 gnu_thread core)
        add_library(OpenNN::mkl_${_opennn_mkl_part} STATIC IMPORTED)
        set_target_properties(OpenNN::mkl_${_opennn_mkl_part} PROPERTIES
            IMPORTED_LOCATION "${_opennn_mkl_dir}/libmkl_${_opennn_mkl_part}.a")
        list(APPEND _opennn_mkl_group OpenNN::mkl_${_opennn_mkl_part})
    endforeach()
    list(JOIN _opennn_mkl_group "," _opennn_mkl_group)
    add_library(OpenNN::mkl INTERFACE IMPORTED)
    set_target_properties(OpenNN::mkl PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_opennn_mkl_include}"
        INTERFACE_LINK_LIBRARIES
            "$<LINK_GROUP:RESCAN,${_opennn_mkl_group}>;Threads::Threads;m;${CMAKE_DL_LIBS}")
    unset(_opennn_mkl_dir)
    unset(_opennn_mkl_include)
    unset(_opennn_mkl_group)
    find_dependency(Threads)
endif()

find_dependency(Eigen3 5.0)

if(@APPLE@)
    find_dependency(OpenNNLibomp)
endif()

if(@_opennn_onednn_system@)
    find_dependency(OpenNNOneDNN)
endif()

if(@_opennn_needs_openmp@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

find_dependency(ZLIB CONFIG COMPONENTS static)

if(@TBB_FOUND@)
    find_dependency(TBB)
endif()

if(@OPENNN_HAS_CUDA@)
    find_dependency(CUDAToolkit)
endif()

if(@_opennn_needs_cudnn@)

    find_dependency(CUDNN 9.0)
endif()

if(@_opennn_needs_mkl@)

    if(NOT DEFINED MKL_LINK)
        set(MKL_LINK "@MKL_LINK@")
    elseif(NOT MKL_LINK STREQUAL "@MKL_LINK@")
        message(FATAL_ERROR
            "OpenNN was built with MKL_LINK=@MKL_LINK@ but this project sets "
            "MKL_LINK=${MKL_LINK}; the resulting MKL::MKL would not match the "
            "installed library.")
    endif()
    if(NOT DEFINED MKL_INTERFACE)
        set(MKL_INTERFACE "@MKL_INTERFACE@")
    elseif(NOT MKL_INTERFACE STREQUAL "@MKL_INTERFACE@")
        message(FATAL_ERROR
            "OpenNN was built with MKL_INTERFACE=@MKL_INTERFACE@ but this "
            "project sets MKL_INTERFACE=${MKL_INTERFACE}; an LP64/ILP64 "
            "mismatch corrupts LAPACK integer arguments.")
    endif()
    find_dependency(MKL CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OpenNNTargets.cmake")

check_required_components(OpenNN)
