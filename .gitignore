*.weights
*.conv.*
*.bin
# The concrete example ships a trained network; Network::load needs this
# sibling of concrete_uci.json, so it is not a regenerable cache.
!examples/concrete/nn/concrete_uci.bin
**/.cache/

# Generated test data
/tests/data/*.xml

# Benchmark exports and measurements; binaries belong in external build trees.
/benchmarks/**/*.onnx
/benchmarks/**/*.onnx.data
/benchmarks/**/*.csv
/benchmarks/**/pred_*.txt

# All benchmark result artifacts are local and must never be committed.
/benchmarks/results/

# OneDrive leaves these when it syncs the repo between machines.
*-DESKTOP-*.cpp
*-DESKTOP-*.h
