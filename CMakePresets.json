{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "verify-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../opennn-build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": false,
        "OpenNN_BUILD_TESTS": true,
        "OpenNN_BUILD_EXAMPLES": false,
        "OpenNN_BUILD_BENCHMARKS": false
      }
    },
    {
      "name": "verify-cpu",
      "displayName": "OpenNN CPU verification",
      "inherits": "verify-base",
      "cacheVariables": {
        "OpenNN_DISABLE_CUDA": true
      }
    },
    {
      "name": "verify-sanitizers",
      "displayName": "Linux CPU AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "verify-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g1 -DNDEBUG -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "OpenNN_UNIT_TEST_TIMEOUT": "1800",
        "OpenNN_ENABLE_LTO": false,
        "OpenNN_ENABLE_MKL": false
      }
    },
    {
      "name": "verify-cuda",
      "displayName": "OpenNN CUDA verification",
      "inherits": "verify-base",
      "cacheVariables": {
        "OpenNN_DISABLE_CUDA": false,
        "OpenNN_REQUIRE_CUDA": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "verify-cpu",
      "configurePreset": "verify-cpu",
      "targets": [
        "opennn_tests",
        "opennn_response_tests"
      ]
    },
    {
      "name": "verify-cuda",
      "configurePreset": "verify-cuda",
      "targets": [
        "opennn_tests",
        "opennn_response_tests"
      ]
    },
    {
      "name": "verify-sanitizers",
      "configurePreset": "verify-sanitizers",
      "targets": [
        "opennn_tests",
        "opennn_response_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "verify-cpu",
      "configurePreset": "verify-cpu",
      "output": { "outputOnFailure": true },
      "environment": { "OPENNN_TEST_REQUIRE_CUDA": "0" }
    },
    {
      "name": "verify-cuda",
      "configurePreset": "verify-cuda",
      "output": { "outputOnFailure": true },
      "environment": { "OPENNN_TEST_REQUIRE_CUDA": "1" }
    },
    {
      "name": "verify-sanitizers",
      "configurePreset": "verify-sanitizers",
      "output": { "outputOnFailure": true },
      "environment": {
        "OPENNN_TEST_REQUIRE_CUDA": "0",
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:allocator_may_return_null=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
